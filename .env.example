# AlumniConnect Environment Variables Configuration Template
# Copy this file to .env or set environment variables in application.properties

# Database Configuration (MySQL 8+)
DB_URL=jdbc:mysql://localhost:3306/alumnidb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=root

# Security & JWT Token Authentication
JWT_SECRET=9a4f2c8d7e1b3a6c5e8f0d2b4a6c9e1f3a5b7c8d0e2f4a6b8c0d2e4f6a8b0c2d
JWT_EXPIRATION_MS=86400000

# File Upload Configuration
FILE_UPLOAD_DIR=uploads/resumes

# AI Service Configuration (Optional: Omit or leave empty to enable MockAIService fallback)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo
